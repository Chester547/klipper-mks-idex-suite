{# Libreria de macros Jinja2 para bloques [tmc2209 <axis>] / [tmc2208 <axis>].
   Uso desde un board .cfg.j2:
     {% import "drivers/tmc2209.cfg.j2" as tmc %}
     {{ tmc.block(profile, 'stepper_x') }}
     {{ tmc.endstop_pin(profile, 'stepper_x', '^PA15') }}
#}

{% macro block(profile, axis) -%}
{%- set d = profile.drivers.get(axis) -%}
{%- if d and d.model in ('tmc2209', 'tmc2208') %}
[{{ d.model }} {{ axis }}]
{% if d.interface == 'uart' %}
uart_pin: {{ d.uart_pin }}
{% if d.uart_address is defined %}
uart_address: {{ d.uart_address }}
{% endif %}
{% elif d.interface == 'spi' %}
cs_pin: {{ d.cs_pin }}
{% endif %}
run_current: {{ d.run_current | default(0.6) }}
hold_current: {{ ((d.run_current | default(0.6)) * (d.hold_current_ratio | default(0.5))) | round(3) }}
sense_resistor: {{ d.sense_resistor | default(0.11) }}
interpolate: {{ 'True' if (d.interpolate | default(true)) else 'False' }}
{# stealthchop_threshold alto == siempre StealthChop; 0 == siempre SpreadCycle. #}
stealthchop_threshold: {{ d.stealthchop_threshold | default(999999) }}
{% if d.model == 'tmc2209' and d.get('sensorless_homing') %}
diag_pin: {{ d.diag_pin }}
driver_SGTHRS: {{ d.driver_sgthrs | default(75) }}
{% endif %}
{% endif -%}
{%- endmacro %}

{% macro endstop_pin(profile, axis, physical_pin) -%}
{%- set d = profile.drivers.get(axis, {}) -%}
{%- if d.get('sensorless_homing') -%}
{{ d.model }}_{{ axis }}:virtual_endstop
{%- else -%}
{{ physical_pin }}
{%- endif -%}
{%- endmacro %}
