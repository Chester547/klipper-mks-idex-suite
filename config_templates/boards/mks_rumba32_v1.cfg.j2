{% include "_safety_banner.j2" %}
{% import "drivers/tmc_common.cfg.j2" as tmc %}
# Confianza de pinout: ALTA (verificado contra
# klipper/config/generic-mks-rumba32-v1.0.cfg). MCU: STM32F446, cristal de
# 12MHz. Conecta por USB directo (ACM), sin metodo de flasheo especial.
#
# RUMBA32 tiene 6 zocalos de driver en total (X,Y,Z,E0,E1,E2): E1/E2 quedan
# libres para IDEX nativo (segundo carro + segundo extrusor) o extrusores
# adicionales, pero el archivo oficial NO da pines confirmados para esos dos
# zocalos (a diferencia del Monster8) -- si haces IDEX en esta placa, medi
# tu propio cableado para dual_carriage/extruder1, no uses una sugerencia.
#
# Nota: el ejemplo oficial usa control:watermark para heater_bed; esta suite
# usa PID de forma consistente en todas las placas (recalibra con
# PID_CALIBRATE HEATER=heater_bed TARGET=... de todos modos).

[mcu]
serial: {{ profile.board.mcu }}
baud: {{ profile.board.baud | default(250000) }}
restart_method: command

[stepper_x]
step_pin: PA0
dir_pin: PC15
enable_pin: !PC11
microsteps: 16
rotation_distance: 40
endstop_pin: {{ tmc.endstop_pin(profile, 'stepper_x', '^PB12') }}
position_endstop: 0
position_max: {{ profile.bed_size_x | default(200) }}
homing_speed: 50
{{ tmc.block(profile, 'stepper_x') }}

[stepper_y]
step_pin: PE5
dir_pin: !PE6
enable_pin: !PE3
microsteps: 16
rotation_distance: 40
endstop_pin: {{ tmc.endstop_pin(profile, 'stepper_y', '^PB15') }}
position_endstop: 0
position_max: {{ profile.bed_size_y | default(200) }}
homing_speed: 50
{{ tmc.block(profile, 'stepper_y') }}

[stepper_z]
step_pin: PE1
dir_pin: PE2
enable_pin: !PB7
microsteps: 16
rotation_distance: 8
{% if profile.probe.type is defined and profile.probe.type != 'none' %}
endstop_pin: probe:z_virtual_endstop
{% else %}
endstop_pin: ^PD9
position_endstop: 0.5
{% endif %}
position_max: 200
{{ tmc.block(profile, 'stepper_z') }}

[extruder]
step_pin: PB5
dir_pin: PB6
enable_pin: !PC12
microsteps: 16
rotation_distance: {{ profile.toolheads[0].rotation_distance | default(33.5) }}
nozzle_diameter: {{ profile.toolheads[0].nozzle_diameter | default(0.4) }}
filament_diameter: 1.75
heater_pin: PC6
sensor_type: {{ profile.toolheads[0].thermistor_type | default('EPCOS 100K B57560G104F') }}
sensor_pin: PC4
control: pid
pid_Kp: 22.2
pid_Ki: 1.08
pid_Kd: 114
min_temp: {{ profile.toolheads[0].min_temp | default(0) }}
max_temp: {{ profile.toolheads[0].max_temp | default(250) }}
max_extrude_only_distance: 100.0
{{ tmc.block(profile, 'extruder') }}

[heater_bed]
heater_pin: PA1
sensor_type: Generic 3950
sensor_pin: PC0
control: pid
pid_Kp: 54.027
pid_Ki: 0.770
pid_Kd: 948.182
min_temp: 0
max_temp: 130

[fan]
pin: PC9
