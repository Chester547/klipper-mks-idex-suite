{% include "_safety_banner.j2" %}
{% import "drivers/tmc2209.cfg.j2" as tmc %}
# Confianza de pinout: ALTA para motores/heaters/fan (verificado contra
# klipper/config/generic-mks-monster8.cfg). Ese archivo es generico (V1/V2
# comparten el mismo mapeo de pines documentado por Klipper mainline);
# confirma UART/SPI de tus TMC2209 contra tu revision fisica V2.0 antes de
# habilitarlos. MCU: STM32F407, bootloader 48KiB.
# Flasheo: 'make' -> copiar out/klipper.bin como 'mks_monster8.bin' a SD/USB.
# Monster8 trae 8 zocalos de driver: es la placa mas comoda de esta suite
# para IDEX nativo (T1 no requiere reutilizar el zocalo de un E1 "prestado").

[mcu]
serial: {{ profile.board.mcu }}
baud: {{ profile.board.baud | default(250000) }}
restart_method: command

[stepper_x]
step_pin: PC14
dir_pin: PC13
enable_pin: !PC15
microsteps: 16
rotation_distance: 40
endstop_pin: {{ tmc.endstop_pin(profile, 'stepper_x', '!PA14') }}
position_endstop: 0
position_max: 235
homing_speed: 50
{{ tmc.block(profile, 'stepper_x') }}

[stepper_y]
step_pin: PE5
dir_pin: !PE4
enable_pin: !PC15
microsteps: 16
rotation_distance: 40
endstop_pin: {{ tmc.endstop_pin(profile, 'stepper_y', '!PA15') }}
position_endstop: 0
position_max: 235
homing_speed: 50
{{ tmc.block(profile, 'stepper_y') }}

[stepper_z]
step_pin: PE1
dir_pin: PE0
enable_pin: !PE2
microsteps: 16
rotation_distance: 8
{% if profile.probe.type is defined and profile.probe.type != 'none' %}
endstop_pin: probe:z_virtual_endstop
{% else %}
endstop_pin: !PB13
position_endstop: 0.0
{% endif %}
position_max: 250
position_min: -5
{{ tmc.block(profile, 'stepper_z') }}

[extruder]
step_pin: PB5
dir_pin: !PB4
enable_pin: !PB6
microsteps: 16
rotation_distance: 33.500
nozzle_diameter: {{ profile.toolheads[0].nozzle_diameter | default(0.4) }}
filament_diameter: 1.75
heater_pin: PB1
sensor_type: {{ profile.toolheads[0].thermistor_type | default('ATC Semitec 104GT-2') }}
sensor_pin: PC1
control: pid
pid_Kp: 21.527
pid_Ki: 1.063
pid_Kd: 108.982
min_temp: {{ profile.toolheads[0].min_temp | default(0) }}
max_temp: {{ profile.toolheads[0].max_temp | default(300) }}
max_extrude_only_distance: 100.0
{{ tmc.block(profile, 'extruder') }}

[heater_bed]
heater_pin: PB10
sensor_type: EPCOS 100K B57560G104F
sensor_pin: PC0
control: pid
pid_Kp: 54.027
pid_Ki: 0.770
pid_Kd: 948.182
min_temp: 0
max_temp: 130

[fan]
pin: PA2

[heater_fan hotend_fan]
pin: PA1
heater: extruder
heater_temp: 50.0
