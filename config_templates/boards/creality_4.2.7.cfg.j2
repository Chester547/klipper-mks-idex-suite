{% include "_safety_banner.j2" %}
{% import "drivers/tmc2209.cfg.j2" as tmc %}
# Confianza de pinout: ALTA (verificado contra
# klipper/config/generic-creality-v4.2.7.cfg). MCU: STM32F103, bootloader
# 28KiB. Conexion tipica por USART1 (PA10/PA9) via adaptador USB-serial, o
# USB directo si tu variante lo trae. Todos los enable_pin comparten !PC3
# (es una particularidad real de esta placa, no un error de copiado).

[mcu]
serial: {{ profile.board.mcu }}
baud: {{ profile.board.baud | default(250000) }}
restart_method: command

[stepper_x]
step_pin: PB9
dir_pin: PC2
enable_pin: !PC3
microsteps: 16
rotation_distance: 40
endstop_pin: {{ tmc.endstop_pin(profile, 'stepper_x', '^PA5') }}
position_endstop: 0
position_max: 235
homing_speed: 50
{{ tmc.block(profile, 'stepper_x') }}

[stepper_y]
step_pin: PB7
dir_pin: PB8
enable_pin: !PC3
microsteps: 16
rotation_distance: 40
endstop_pin: {{ tmc.endstop_pin(profile, 'stepper_y', '^PA6') }}
position_endstop: 0
position_max: 235
homing_speed: 50
{{ tmc.block(profile, 'stepper_y') }}

[stepper_z]
step_pin: PB5
dir_pin: !PB6
enable_pin: !PC3
microsteps: 16
rotation_distance: 8
{% if profile.probe.type is defined and profile.probe.type != 'none' %}
endstop_pin: probe:z_virtual_endstop
{% else %}
endstop_pin: ^PA7
position_endstop: 0.0
{% endif %}
position_max: 250
position_min: -5
{{ tmc.block(profile, 'stepper_z') }}

[extruder]
step_pin: PB3
dir_pin: PB4
enable_pin: !PC3
microsteps: 16
rotation_distance: 33.500
nozzle_diameter: {{ profile.toolheads[0].nozzle_diameter | default(0.4) }}
filament_diameter: 1.75
heater_pin: PA1
sensor_type: {{ profile.toolheads[0].thermistor_type | default('EPCOS 100K B57560G104F') }}
sensor_pin: PC5
control: pid
pid_Kp: 21.527
pid_Ki: 1.063
pid_Kd: 108.982
min_temp: {{ profile.toolheads[0].min_temp | default(0) }}
max_temp: {{ profile.toolheads[0].max_temp | default(260) }}
max_extrude_only_distance: 100.0
{{ tmc.block(profile, 'extruder') }}

[heater_bed]
heater_pin: PA2
sensor_type: EPCOS 100K B57560G104F
sensor_pin: PC4
control: pid
pid_Kp: 54.027
pid_Ki: 0.770
pid_Kd: 948.182
min_temp: 0
max_temp: 130

[fan]
pin: PA0
