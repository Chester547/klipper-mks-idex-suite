{% include "_safety_banner.j2" %}
{% import "drivers/tmc_common.cfg.j2" as tmc %}
# Confianza de pinout: ALTA para stepper_x/y, extruder y TMC2209 UART
# (verificado contra klipper/config/generic-mks-robin-e3.cfg). Esta placa
# trae TMC2209 de fabrica en las 4 posiciones -- confirma los uart_pin
# sugeridos igual, pero es menos probable que necesites cambiarlos.
#
# stepper_z usa los pines de la revision V1.1 (confirmado por la foto de
# placa que me pasaste, silkscreen "MKS Robin E3 V1.1"). Si tu placa es V1.0,
# cambia step_pin/dir_pin de stepper_z a PB7/!PB6 (comentario original del
# archivo mainline: "Please note pin name change for stepper Z for v1.1").
#
# ADVERTENCIA EXTRA sobre heater_bed: el archivo oficial de Klipper para esta
# placa deja heater_bed comentado e incompleto (ni el propio mainline lo
# confirma del todo). Los valores de abajo (PC8/PA1) son la mejor referencia
# disponible, pero verificalos con multimetro/continuidad contra tu placa
# fisica ANTES de conectar la cama por primera vez -- mas que en el resto de
# las placas de esta suite.

[mcu]
serial: {{ profile.board.mcu }}
baud: {{ profile.board.baud | default(250000) }}
restart_method: command

[stepper_x]
step_pin: PC0
dir_pin: PB2
enable_pin: !PC13
microsteps: 16
rotation_distance: 40
endstop_pin: {{ tmc.endstop_pin(profile, 'stepper_x', '^PA12') }}
position_endstop: 0
position_max: {{ profile.bed_size_x | default(165) }}
homing_speed: 50
{{ tmc.block(profile, 'stepper_x') }}

[stepper_y]
step_pin: PC2
dir_pin: PB9
enable_pin: !PB12
microsteps: 16
rotation_distance: 40
endstop_pin: {{ tmc.endstop_pin(profile, 'stepper_y', '^PA11') }}
position_endstop: 0
position_max: {{ profile.bed_size_y | default(165) }}
homing_speed: 50
{{ tmc.block(profile, 'stepper_y') }}

[stepper_z]
step_pin: PC14
dir_pin: !PC15
enable_pin: !PB8
microsteps: 16
rotation_distance: 8
{% if profile.probe.type is defined and profile.probe.type != 'none' %}
endstop_pin: probe:z_virtual_endstop
{% else %}
endstop_pin: ^PC6
position_endstop: 0
{% endif %}
position_max: 200
{{ tmc.block(profile, 'stepper_z') }}

[extruder]
step_pin: PB4
dir_pin: PB3
enable_pin: !PB5
microsteps: 16
rotation_distance: {{ profile.toolheads[0].rotation_distance | default(33.5) }}
nozzle_diameter: {{ profile.toolheads[0].nozzle_diameter | default(0.4) }}
filament_diameter: 1.75
heater_pin: PC9
sensor_type: {{ profile.toolheads[0].thermistor_type | default('EPCOS 100K B57560G104F') }}
sensor_pin: PA0
control: pid
pid_Kp: 21.527
pid_Ki: 1.063
pid_Kd: 108.982
min_temp: {{ profile.toolheads[0].min_temp | default(0) }}
max_temp: {{ profile.toolheads[0].max_temp | default(250) }}
max_extrude_only_distance: 100.0
{{ tmc.block(profile, 'extruder') }}

[heater_bed]
heater_pin: PC8
sensor_type: EPCOS 100K B57560G104F
sensor_pin: PA1
control: pid
pid_Kp: 54.027
pid_Ki: 0.770
pid_Kd: 948.182
min_temp: 0
max_temp: 130

[fan]
pin: PA8
